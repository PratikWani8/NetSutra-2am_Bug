# NetSutra AI and Detection Service Configuration

# Service host and port
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Provider A: Gemma API (Google AI Studio / Generative Language API)
# Get your API key from https://aistudio.google.com/
GEMMA_API_KEY=
GEMMA_API_MODEL=gemma-2-9b-it
# Optional: GEMMA_API_BASE_URL (defaults to https://generativelanguage.googleapis.com/v1beta)
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Provider B: Local Ollama
# Ensure Ollama is running and model is downloaded (e.g., ollama run gemma2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# Detection & Baseline Configuration
MIN_BASELINE_EVENTS=5
HIGH_BASELINE_EVENTS=20
CORRELATION_WINDOW_SECONDS=300.0
VOLUME_ZSCORE_THRESHOLD=3.0
VOLUME_RATIO_THRESHOLD=3.0
FREQUENCY_BURST_THRESHOLD=5.0
FAILED_CONNECTION_RATIO_THRESHOLD=0.5
LOG_LEVEL=INFO
